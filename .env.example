# Copy to .env.local for local development (git-ignored).
# In production these are set in the Vercel project settings.

# Postgres connection string
DATABASE_URL=postgres://postgres@localhost:5432/zoeart_dev

# Secret used to sign admin login tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (image hosting). Leave empty locally to store uploads in Postgres instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used once by `npm run db:setup` to create the first admin when no user exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Extra origins allowed to call the API (comma-separated), optional.
ALLOWED_ORIGINS=

# Public address used in the sitemap and share links, optional.
# Defaults to the address the request came in on.
SITE_URL=https://www.aetherartspace.com
