{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "installCommand": "npm install",
        "buildCommand": "npm run build"
      }
    },
    {
      "src": "server/index.cjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "maxRequestBodySize": "50mb"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/index.cjs"
    },
    {
      "source": "/sitemap.xml",
      "destination": "server/index.cjs"
    },
    {
      "source": "/:kind(exhibition|artist|artwork)/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|SkypeUriPreview|vkShare|Iframely|Mastodon).*"
        }
      ],
      "destination": "server/index.cjs"
    },
    {
      "source": "/:page(exhibitions|artists|collection|about|contact)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|SkypeUriPreview|vkShare|Iframely|Mastodon).*"
        }
      ],
      "destination": "server/index.cjs"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|Discordbot|Pinterest|redditbot|Embedly|SkypeUriPreview|vkShare|Iframely|Mastodon).*"
        }
      ],
      "destination": "server/index.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "JWT_SECRET": "aether-art-space-jwt-secret-2024"
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(logo|collaborators)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
